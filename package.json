{
  "name": "tredgate-loan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -c cyan,green,magenta npm:dev:web npm:dev:api npm:dev:rag",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:rag": "tsx watch rag/server.ts",
    "start": "npm run build && tsx server/index.ts",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "data:reset": "tsx server/reset.ts",
    "data:large": "tsx server/generateLargeData.ts",
    "rag": "tsx rag/cli.ts",
    "rag:index": "tsx rag/cli.ts --index",
    "rag:serve": "tsx rag/server.ts",
    "inspector": "mcp-inspector",
    "legacy:nightly": "node scripts/nightly-fees.js"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "vue": "^3.5.24",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/inspector": "^2.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.0",
    "jsdom": "^27.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.13",
    "vue-tsc": "^3.1.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}
